pkg_settings <- function(...) {
args <- list(...)
# Case 1: No arguments -> Return all current settings
if (length(args) == 0) {
return(as.list(.settings_env))
}
# Case 2: Named arguments -> Overwrite/update settings
if (!is.null(names(args))) {
for (name in names(args)) {
if (name != "") {
assign(name, args[[name]], envir = .settings_env)
}
}
return(invisible(as.list(.settings_env)))
}
# Case 3: Single unnamed character string -> Return that specific setting
if (length(args) == 1 && is.null(names(args)) && is.character(args[[1]])) {
key <- args[[1]]
if (exists(key, envir = .settings_env)) {
return(get(key, envir = .settings_env))
} else {
warning(paste("Setting '", key, "' does not exist.", sep = ""))
return(NULL)
}
}
stop("Invalid arguments provided to pkg_settings().")
}
pkg_settings <- function(...) {
args <- list(...)
# Case 1: No arguments -> Return all current settings
if (length(args) == 0) {
return(as.list(.dt_settings))
}
# Case 2: Named arguments -> Overwrite/update settings
if (!is.null(names(args))) {
for (name in names(args)) {
if (name != "") {
assign(name, args[[name]], envir = .dt_settings)
}
}
return(invisible(as.list(.dt_settings)))
}
# Case 3: Single unnamed character string -> Return that specific setting
if (length(args) == 1 && is.null(names(args)) && is.character(args[[1]])) {
key <- args[[1]]
if (exists(key, envir = .dt_settings)) {
return(get(key, envir = .dt_settings))
} else {
warning(paste("Setting '", key, "' does not exist.", sep = ""))
return(NULL)
}
}
stop("Invalid arguments provided to pkg_settings().")
}
